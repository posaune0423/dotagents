  },
  "runtime": {
    "execution": "local",
    "workingDirectory": "select-on-install",
    "stateDirectory": "/Users/asumayamada/.local/state/dotagents/safe-dev-storage-cleanup",
    "isolation": "shared",
    "platforms": ["macos"]
  },
  "targets": ["claude-desktop-local", "codex-local"]
}
