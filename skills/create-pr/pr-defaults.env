# Sourced by create-pr helper scripts (set -a; do not use spaces around '=').
#
# Assignees: comma-separated GitHub logins. Use @me for the authenticated user.
# Leave empty to skip assignees on new PRs / sync.
CREATE_PR_ASSIGNEES=@me

# Labels: optional comma-separated names. When unset or empty, one label is inferred
# from the branch prefix using GitHub's stock default labels (bug, documentation,
# enhancement, etc.). Set CREATE_PR_NO_LABEL=1 to skip labels entirely.
# CREATE_PR_LABELS=bug,documentation
# CREATE_PR_NO_LABEL=1
