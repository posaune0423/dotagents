# Copy to .env and fill in whichever providers you actually have.
# .env is gitignored by the repository root; never commit real keys.
#
# Anything left unset makes that provider report exit 4 (auth) and the router
# simply skips it, so a partially filled file is a working configuration.
#
# Values already present in the environment win: this file never overrides an
# exported variable.

# --- hosted inference (OpenAI-compatible) ---
# console.groq.com -- 30 req/min, ~1,000 req/day, 8K tokens/min
GROQ_API_KEY=

# openrouter.ai -- 20 req/min, 50 req/day on :free models
OPENROUTER_API_KEY=
# The :free roster changes monthly; pin a live id here.
# PIGGYBACK_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# console.mistral.ai -- free Experiment tier, limits unpublished
MISTRAL_API_KEY=

# --- agentic CLIs -----------------------------------------------------------
# Antigravity (agy) signs in interactively with `agy login`; no key goes here.
# It replaced gemini-cli, whose free tier for individuals was discontinued.

# Cursor CLI normally uses `cursor-agent login`; a key is only for CI.
# CURSOR_API_KEY=

# --- model overrides (optional) ---------------------------------------------
# PIGGYBACK_GROQ_MODEL=openai/gpt-oss-20b
# PIGGYBACK_MISTRAL_MODEL=mistral-small-latest

# --- routing overrides (optional) -------------------------------------------
# PIGGYBACK_CHAIN_INFERENCE=groq,openrouter,mistral,antigravity,cursor,copilot
# PIGGYBACK_CHAIN_AGENTIC=antigravity,cursor,copilot
# PIGGYBACK_PROFILES_FILE=/path/to/your/profiles.conf
# PIGGYBACK_COOLDOWN_QUOTA=3600
