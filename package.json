{
  "name": "dotagents",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "bunx lefthook install",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "lint": "bunx eslint .",
    "check": "bun run lint && bun run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.0",
    "jiti": "^2.5.0",
    "lefthook": "^1.12.7",
    "prettier": "^3.6.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": false,
    "useTabs": false,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "printWidth": 120,
    "endOfLine": "lf"
  }
}
