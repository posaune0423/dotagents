{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/block-git-policy.sh",
            "statusMessage": "Checking Git worktree policy",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/user_prompt_submit_proactive_context.sh"
          }
        ]
      }
    ]
  }
}
